{
  "title": "Kartoffelsuppe",
  "slug": "kartoffelsuppe",
  "category": "Vegetarisch",
  "servings": "für 6 Personen",
  "order": 38,
  "created": null,
  "image": "image.jpg",
  "thumb": null,
  "ingredients": [
    {
      "group": null,
      "text": [
        "30 g Butter",
        "1 Zwiebel, klein geschnitten",
        "1 kg Kartoffeln, gewürfelt",
        "1 Liter Wasser",
        "1 Kohlrabi",
        "4 Möhren, klein geschnitten",
        "2 Paprika, klein geschnitten",
        "2 TL Salz",
        "6 TL Essig",
        "6 Würstchen"
      ]
    }
  ],
  "steps": [
    "Die Butter in einem großen Topf erhitzen und die Zwiebel dünsten.",
    "Kartoffeln mit dem Wasser hinzugeben und 15 Minuten kochen lassen.",
    "Gemüse hinzufügen. Weitere 10 Minuten kochen lassen.",
    "Mit Saft und Essig abschmecken.",
    "Würstchen hinzugeben und 5 Minuten weiter köcheln lassen."
  ],
